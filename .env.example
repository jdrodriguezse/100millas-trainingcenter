# ============================================================
# 100 Millas Training Center - Plantilla de variables de entorno
# ============================================================
# Copia este archivo como ".env" y coloca tus valores reales.

# Base de datos PostgreSQL (recomendado: Neon - https://neon.tech)
# Formato: postgresql://USUARIO:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST/neondb?sslmode=require"

# Secreto para la autenticación (NextAuth).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="cambia-este-secreto-por-uno-seguro"

# URL base de la aplicación (en producción usa tu dominio, ej: https://100millas.com)
AUTH_URL="http://localhost:3000"

# Confiar en el host del proxy (requerido en Vercel / produccion).
AUTH_TRUST_HOST="true"

# Nombre del sistema
NEXT_PUBLIC_APP_NAME="100 Millas Training Center"
